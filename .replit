modules = ["web", "python-3.11", "nodejs-24", "postgresql-16"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["freetype", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "postgresql", "tcl", "tk", "zlib"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 server.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["python3", "-m", "gunicorn", "--bind", "0.0.0.0:5000", "--reuse-port", "server:app"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[objectStorage]
defaultBucketID = "replit-objstore-fc5e0d02-c2a9-4928-a694-46950fbcb6d1"

[userenv]

[userenv.shared]
PARTNER_IMAGE_BUCKET_ID = "replit-objstore-fc5e0d02-c2a9-4928-a694-46950fbcb6d1"
